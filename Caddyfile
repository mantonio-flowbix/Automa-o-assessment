# Reverse proxy in front of the Flask app: terminates TLS and gates access
# with basic auth, since this server now stores real client credentials
# (in each client's .env, see flowbix_assess/clientstore.py) and is reachable
# by the whole team over the company network, not just 127.0.0.1.
#
# `tls internal` issues a self-signed cert from Caddy's own CA — fine for an
# internal-only server without a public domain. If this VM already sits
# behind company VPN/SSO, the `basic_auth` block below can be removed
# (keep `tls internal` for encryption in transit either way).
:443 {
	# `on_demand`: the site block has no fixed hostname (people reach it by
	# IP), so Caddy has no static host to pre-issue a cert for. Without this,
	# every handshake fails with "no certificate available" — safe to enable
	# here because the `internal` issuer has no external rate limits/abuse
	# surface (unlike a public ACME CA), so it doesn't need the `ask`/
	# `permission` gate that on-demand normally requires.
	tls internal {
		on_demand
	}

	basic_auth {
		{$APP_BASIC_AUTH_USER} {$APP_BASIC_AUTH_HASH}
	}

	reverse_proxy flowbix-assess:5050
}
